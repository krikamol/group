---
layout: default
---

<style>
html[data-theme='light'] {
  --riss-card-bg: #f9f9f9;
}

html[data-theme='dark'] {
  --riss-card-bg: #1e1e1e;
}

html[data-theme='light'] {
  --riss-talk-bg: #f9f9f9;
}

html[data-theme='dark'] {
  --riss-talk-bg: #1e1e1e;
}

.riss-talk {
  margin-top: 2rem;
  display: flex;
  background-color: var(--riss-talk-bg);
  border-radius: 1rem;
  box-shadow: 0 4px 10px rgba(0,0,0,0.08);
  padding: 1.5rem;
  flex-wrap: wrap;
  gap: 1.5rem;
  align-items: flex-start;
}
.riss-image {
  width: 200px;
  flex-shrink: 0;
}

.riss-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
  border-radius: 1rem;
}

.riss-details {
  flex: 1;
}

.riss-details h1 {
  font-size: 1.8rem;
  margin-top: 0;
  margin-bottom: 0.5rem;
}

.riss-details p {
  font-size: 1rem;
  margin: 0.3rem 0;
}

.riss-zoom-button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background-color: #0b5cff;
  color: white !important;
  text-decoration: none;
  padding: 0.5rem 1.1rem;
  border-radius: 0.5rem;
  margin: 0.8rem 0 0.4rem;
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(11, 92, 255, 0.35);
}

.riss-zoom-button:hover {
  background-color: #0948cc;
}

</style>
<div class="riss-header">
  <h1>Rational Intelligence Seminar Series</h1>
  <p class="post-description">The Rational Intelligence Seminar Series (RISS), seeks to advance the understanding of rationality, efficiency and reliability in machine learning systems. These seminars serve as a forum for discussions and quick dissemination of results.</p>
</div>

<div class="riss-talk">
  {% if page.image %}
  <div class="riss-image">
    <img src="{{ page.image | relative_url }}" alt="{{ page.title }}">
  </div>
  {% endif %}

  <div class="riss-details">
    <h1>{{ page.title }}</h1>
    {% if page.speaker_name %}
      <p><strong>{{ page.speaker_name }}</strong> – {{ page.speaker_title }}</p>
    {% endif %}
    <p><i class="fa fa-calendar"></i> {{ page.date_in_string }} at {{ page.time_in_string }}</p>
    {% assign today = site.time | date: "%Y-%m-%d" %}
    {% assign zoom_url = page.zoom_url %}
    {% if zoom_url == nil and page.location contains "zoom" %}
      {% assign zoom_url = page.location | split: 'href="' | last | split: '"' | first %}
    {% endif %}
    {% if zoom_url %}
      <p><i class="fa fa-map-marker"></i> Online</p>
      {% if page.sort_key >= today %}
        <a href="{{ zoom_url }}" class="riss-zoom-button" target="_blank"><i class="fa-solid fa-video"></i> Join on Zoom</a>
      {% endif %}
    {% else %}
      <p><i class="fa fa-map-marker"></i> {{ page.location }}</p>
    {% endif %}
    <p><strong>Keywords:</strong> {{ page.keywords }}</p>
  </div>
  <div>
  {{ content }}
</div>
</div>

